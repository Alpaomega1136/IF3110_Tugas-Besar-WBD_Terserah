# Local development only. Change credentials for deployment.
# Go reads process environment; copying this file to .env does NOT load it.
# From BE/, export DATABASE_URL, HTTP_ADDR, APP_ORIGIN and TARGET_CREDENTIAL_KEY
# before running go run ./cmd/api. APP_ORIGIN must match the browser origin,
# including scheme/host/port, without a trailing slash.
DATABASE_URL=postgres://platform:platform_dev_only@localhost:5432/platform?sslmode=disable
HTTP_ADDR=:8080
APP_ORIGIN=http://localhost:8080
# Required by the API: base64-encoded 32 random bytes. Generate once; keep private.
TARGET_CREDENTIAL_KEY=

# PowerShell first-run example (set DATABASE_URL to your metadata connection):
# $env:DATABASE_URL = 'postgres://platform:platform_dev_only@localhost:5432/platform?sslmode=disable'
# $env:HTTP_ADDR = ':8080'
# $env:APP_ORIGIN = 'http://localhost:8080'
# $keyBytes = New-Object byte[] 32
# $keyRng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $keyRng.GetBytes($keyBytes)
# $keyRng.Dispose()
# $env:TARGET_CREDENTIAL_KEY = [Convert]::ToBase64String($keyBytes)
# Keep this key private and reuse it across restarts; generate only once.
# go run ./cmd/migrate
# Set BOOTSTRAP_USERNAME and BOOTSTRAP_PASSWORD privately, then:
# go run ./cmd/bootstrap
# Remove-Item Env:\BOOTSTRAP_PASSWORD
# go run ./cmd/api
# Each target needs a restricted executor and history provisioning as its owner:
# psql ... -v executor_role=app_executor -f sql/provision_target_history.sql

# First admin: BOOTSTRAP_USERNAME / BOOTSTRAP_PASSWORD with go run ./cmd/bootstrap.
# Compatibility CLI: ADMIN_USERNAME / ADMIN_PASSWORD with go run ./cmd/seed.
# Both create the first admin only; passwords must contain 12-1024 bytes.
# Seed applies metadata migrations but never resets an existing account.
