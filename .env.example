# Windows: .\dev.cmd starts FE + BE and loads .env without executing its contents.
# First run without .env offers local database setup and first-admin bootstrap.
# .\dev.cmd fe | .\dev.cmd be | .\dev.cmd setup | .\dev.cmd admin
# For an existing database, copy this file to .env and fill the existing secrets.
# Raw `go run` commands still require exporting the environment manually.
DATABASE_URL=postgres://platform:CHANGE_ME@localhost:5432/platform?sslmode=disable
HTTP_ADDR=:8080
APP_ORIGIN=http://localhost:3000
# Base64-encoded 32-byte key. Preserve the existing key when reusing metadata.
TARGET_CREDENTIAL_KEY=
FE_HTTP_ADDR=:3000
FE_BACKEND_URL=http://localhost:8080
# The API runs two worker slots by default. Disable only when running cmd/worker separately.
WORKER_EMBEDDED=true
# Optional: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Without an OTLP endpoint, sanitized OpenTelemetry spans are written to JSON logs.
